{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "refund tool input",
  "type": "object",
  "required": ["requestId", "orderId", "amount"],
  "additionalProperties": false,
  "properties": {
    "requestId": { "type": "string", "minLength": 8, "description": "Unique per tool call; repeated calls with the same id are not executed again." },
    "orderId": { "type": "string", "pattern": "^[A-Z]{2}-[0-9]+$" },
    "amount": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 },
    "reason": { "type": "string", "maxLength": 200 }
  }
}
